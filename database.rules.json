{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth !== null",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },

    "siswa": {
      "$kelas": {
        ".read": "auth !== null",
        ".write": "auth !== null"
      }
    },

    "nilai": {
      "$tahun": {
        "$semester": {
          "$kelas": {
            ".read": "auth !== null",
            ".write": "auth !== null"
          }
        }
      }
    },

    "absensi_siswa": {
      "$tahun": {
        "$kelas": {
          "$tanggal": {
            ".read": "auth !== null",
            ".write": "auth !== null"
          }
        }
      }
    }
  }
}
